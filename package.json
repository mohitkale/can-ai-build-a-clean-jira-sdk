{
  "name": "jira-cloud-v3-sdk",
  "version": "0.1.0",
  "description": "Production-quality TypeScript SDK for the Jira Cloud REST API v3, generated from Atlassian's official OpenAPI specification with @hey-api/openapi-ts.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "openapi",
    "AGENTS.md",
    "ARCHITECTURE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "download-spec": "node scripts/download-spec.mjs",
    "generate": "node scripts/download-spec.mjs --check-only 2>/dev/null; openapi-ts",
    "generate:force": "openapi-ts",
    "coverage": "node scripts/coverage.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "lint": "eslint src tests examples scripts openapi-ts.config.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run generate:force && npm run coverage && npm run typecheck && npm run typecheck:examples && npm run lint && npm test && npm run build && npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohitkale/can-ai-build-a-clean-jira-sdk.git"
  },
  "homepage": "https://github.com/mohitkale/can-ai-build-a-clean-jira-sdk#readme",
  "bugs": {
    "url": "https://github.com/mohitkale/can-ai-build-a-clean-jira-sdk/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^22.20.2",
    "eslint": "^9.14.0",
    "globals": "^17.12.0",
    "tsup": "^8.3.5",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.13.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "jira",
    "jira-cloud",
    "atlassian",
    "sdk",
    "rest-api",
    "typescript",
    "openapi"
  ]
}
